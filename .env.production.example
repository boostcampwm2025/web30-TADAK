# MySQL 설정 (프로덕션)
MYSQL_ROOT_PASSWORD=your_strong_root_password
MYSQL_DATABASE=web30
MYSQL_USER=web30
MYSQL_PASSWORD=your_strong_password

# 백엔드 API 환경변수
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=web30
DB_PASSWORD=your_strong_password
DB_DATABASE=web30

# Redis 설정
REDIS_HOST=redis
REDIS_PORT=6379

# Judge Docker 경로 (컨테이너 내부/볼륨 경로)
JUDGE_VOLUME=/judge-data
JUDGE_PROBLEMS_PATH=/judge-data
JUDGE_SUBMISSIONS_PATH=/judge-data/submissions
JUDGE_DISABLE_CLEANUP=false

# 서버 설정
PORT=3000

VITE_API_BASE_URL=https://www.tadak.site
VITE_API_URL=https://www.tadak.site

# 인증 (JWT)
JWT_SECRET=your_jwt_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret

# OAuth (GitHub)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=https://www.tadak.site/api/auth/github/return
